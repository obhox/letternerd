{
  "name": "@cms/db",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, roles and API keys.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./api-keys": "./src/api-keys.ts"
