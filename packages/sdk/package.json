{
  "name": "@obhox/cms-sdk",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client that server-renders CMS content inside a consuming site.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js", "require": "./dist/next.cjs" },
    "./legacy": { "types": "./dist/legacy.d.ts", "import": "./dist/legacy.js", "require": "./dist/legacy.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@cms/media": "workspace:*",
    "@cms/seo": "workspace:*",
    "@types/react": "^19.0.7",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true }
  }
}
