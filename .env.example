# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
# Values here are the local-dev defaults produced by `pnpm infra:up`.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
DATABASE_URL=postgresql://cms:cms@localhost:5434/cms

# --- auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Production refuses any value under 32 characters or matching a known
# placeholder — this one included — and the studio does not start.
BETTER_AUTH_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-48
CMS_STUDIO_URL=http://localhost:3000
CMS_TRUSTED_ORIGINS=http://localhost:3000

# --- scheduled jobs -------------------------------------------------------
# Coolify Scheduled Tasks present this as a bearer token to /api/cron/[job].
# Production refuses any value under 32 characters or matching a known
# placeholder; the endpoint then refuses everything rather than accept a
# published credential. openssl rand -hex 32
CRON_SECRET=dev-cron-secret

# --- media storage --------------------------------------------------------
# s3 | local
MEDIA_STORAGE_DRIVER=s3
# Set S3_ENDPOINT for MinIO/R2; leave empty for real AWS S3 (enables path-style).
S3_ENDPOINT=http://localhost:9100
S3_REGION=auto
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=cmsminio
S3_SECRET_ACCESS_KEY=cmsminio123
MEDIA_CDN_URL=http://localhost:9100/cms-media
MEDIA_MAX_UPLOAD_BYTES=26214400

# --- access control -------------------------------------------------------
# true | false. Whether anyone may create an account. Open by default; set to
# false to admit only addresses that hold a live invitation.
CMS_ALLOW_SIGNUP=true
# The header the rate limiters read the client address from. Only trustworthy
# when the proxy in front overwrites it; Traefik does. cf-connecting-ip behind
# Cloudflare. See infra/DEPLOY.md, "Reverse-proxy headers".
CMS_CLIENT_IP_HEADER=x-forwarded-for
# owner | editor | author | none. The lowest site role that must enrol TOTP
# before the studio serves it. Unset means owner in production, none elsewhere.
CMS_REQUIRE_2FA_ROLE=none
# `off` disables the studio's request budgets. For end-to-end suites only;
# leave it unset everywhere else.
# CMS_RATE_LIMIT=off

# --- email (optional in dev, REQUIRED in production) ----------------------
RESEND_API_KEY=
EMAIL_FROM=cms@example.com

# --- misc -----------------------------------------------------------------
LOG_LEVEL=info

# --- client-exposed -------------------------------------------------------
NEXT_PUBLIC_CMS_STUDIO_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_CDN_URL=http://localhost:9100/cms-media

# --- analytics connections (optional) -------------------------------------
# Google Search Console OAuth. The studio boots without these; the Analytics
# settings screen then names which are missing. Register the redirect URI in
# Google Cloud Console EXACTLY as <CMS_STUDIO_URL>/api/oauth/google/callback —
# a mismatch is the most common failure and surfaces only as exchange_failed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth tokens and webhook signing secrets at rest.
# openssl rand -hex 32
# Optional at boot, REQUIRED before creating a webhook or connecting Search
# Console: the cipher refuses to store a secret in plaintext rather than
# falling back. Rotating it means re-encrypting; see infra/DEPLOY.md.
ANALYTICS_ENCRYPTION_KEY=
