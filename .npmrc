# A published version must be at least seven days old before pnpm will resolve
# to it.
#
# This defends against one specific attack: an attacker takes over a
# maintainer's npm account and ships a malicious patch release of a package
# this repository already depends on. Nothing in package.json changes; a plain
# `pnpm update`, or Dependabot's pull request the same morning, pulls it in. A
# week is long enough for such a release to be noticed and unpublished — the
# incidents so far were caught within hours — and it costs nothing on
# `--frozen-lockfile` installs, which never resolve. Dependabot's own cooldown
# in .github/dependabot.yml is set to the same seven days so the two agree.
minimum-release-age=10080

# Re-check every package's contents against the integrity hash the store
# recorded for it, rather than trusting a store that could have been altered.
verify-store-integrity=true

# A peer mismatch warns instead of failing the install. The workspace has a few
# that are known and harmless, and a hard failure here is the kind that gets
# the flag flipped in a hurry during an incident.
strict-peer-dependencies=false
