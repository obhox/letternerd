{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "CMS_STUDIO_URL",
    "CMS_TRUSTED_ORIGINS",
    "CRON_SECRET",
    "ANALYTICS_ENCRYPTION_KEY",
    "CMS_ALLOW_SIGNUP",
    "CMS_CLIENT_IP_HEADER",
    "CMS_REQUIRE_2FA_ROLE",
    "CMS_RATE_LIMIT",
    "MEDIA_STORAGE_DRIVER",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "MEDIA_CDN_URL",
    "MEDIA_MAX_UPLOAD_BYTES",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "LOG_LEVEL",
    "CMS_AUTH_RATE_LIMIT",
    "CMS_REQUIRE_EMAIL_VERIFICATION",
    "NEXT_PUBLIC_CMS_STUDIO_URL",
    "NEXT_PUBLIC_MEDIA_CDN_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
