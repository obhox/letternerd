# Plain Node runner for workspace scripts — migrations today, a background
# worker later. Alpine is fine here because nothing in this image touches sharp.
#
# It runs tsx against a package's source, so it needs that package's sources and
# a node_modules tree it can resolve from — nothing bundled, nothing built.
#
# This used to call `pnpm deploy --legacy` to prune a standalone tree. That is
# the one thing this image must not do: the legacy implementation cannot read a
# shared workspace lockfile, so it re-resolved every dependency at build time.
# The image was therefore never pinned to the lockfile, and the build broke the
# day Next published 16.3.4 — `minimum-release-age` in .npmrc was inspecting
# those resolutions, which is the only reason anyone noticed. A frozen-lockfile
# install of just this package's production closure gets a pinned tree instead,
# and cannot break because an unrelated package published a release.

ARG APP=@cms/db

# Digest-pinned for the same reason as Dockerfile.studio: a tag moves, a digest
# does not, and Dependabot's docker ecosystem bumps this one line (it only
# follows literal `FROM image:tag@sha256` lines, which is why this is a stage
# and not an ARG).
FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS base

FROM base AS deps
# Node stopped bundling corepack by default as of this major version; install
# it from npm before enabling, or `corepack enable` fails with "not found".
RUN npm install --global corepack@latest && corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/core/package.json    packages/core/
COPY packages/db/package.json      packages/db/
COPY packages/auth/package.json    packages/auth/
COPY packages/content/package.json packages/content/
COPY packages/seo/package.json     packages/seo/
COPY packages/media/package.json   packages/media/
COPY packages/analytics/package.json    packages/analytics/
COPY packages/capabilities/package.json packages/capabilities/

# `<pkg>...` selects the package and its workspace dependencies, so the tree is
# this app's production closure rather than the whole monorepo's. --prod drops
# drizzle-kit, vitest and typescript, which nothing at runtime imports;
# --frozen-lockfile is what keeps the versions the ones CI tested.
ARG APP=@cms/db
RUN pnpm install --frozen-lockfile --prod --filter "${APP}..."

FROM deps AS build
WORKDIR /repo
COPY . .

FROM base AS runtime
ENV NODE_ENV=production
RUN apk add --no-cache tini
RUN addgroup -S cms && adduser -S cms -G cms

# The whole workspace, not one pruned package. pnpm's node_modules is a tree of
# symlinks into a virtual store at the repo root, so a package directory lifted
# out of it on its own resolves nothing — keeping the layout intact is what
# makes the links valid.
WORKDIR /app
COPY --from=build --chown=cms:cms /repo /app

# The package this image runs, so `node_modules/.bin/tsx src/migrate.ts` — the
# command infra/docker-compose.production.yml passes — resolves exactly as it
# does in a developer's checkout.
ARG APP=@cms/db
WORKDIR /app/packages/db

USER cms
ENTRYPOINT ["/sbin/tini", "--"]
# Overridden per service; the migrate service runs `tsx src/migrate.ts`.
CMD ["node", "--version"]
