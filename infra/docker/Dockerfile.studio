# The studio: admin UI, REST API and the remote MCP endpoint, in one image.
#
# Debian slim rather than Alpine, which is the one real departure from the
# Falorb recipe this is otherwise copied from. sharp's prebuilt binaries target
# glibc; the musl builds pull a different libvips and fail at runtime in ways
# that only show up when someone uploads an image. An image a few tens of
# megabytes larger is a good trade for an upload path that works.

ARG NODE_VERSION=22-slim

# --- dependencies -------------------------------------------------------------
FROM node:${NODE_VERSION} AS deps
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Every workspace package that has dependencies of its own needs its manifest
# copied here, not just the ones apps/studio imports directly: pnpm reads each
# package.json to learn what *that* package depends on, and a package whose
# manifest is missing at install time is invisible — its dependencies are never
# linked, and an import from inside its own source fails the build with
# "Module not found". Add a line here whenever a package gains its first
# dependency.
COPY packages/core/package.json    packages/core/
COPY packages/db/package.json      packages/db/
COPY packages/auth/package.json    packages/auth/
COPY packages/content/package.json packages/content/
COPY packages/seo/package.json     packages/seo/
COPY packages/media/package.json   packages/media/
COPY packages/analytics/package.json    packages/analytics/
COPY packages/capabilities/package.json packages/capabilities/
COPY packages/ui/package.json      packages/ui/
COPY packages/sdk/package.json     packages/sdk/
COPY apps/studio/package.json      apps/studio/

RUN pnpm install --frozen-lockfile

# --- build --------------------------------------------------------------------
FROM deps AS build
WORKDIR /repo
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    # @cms/auth REFUSES TO CONSTRUCT when verification is required and no mail
    # sender is configured — deliberately, so a production deploy cannot
    # silently accept unverified addresses. `next build` evaluates the auth
    # route while collecting page data, and the build stage has no mail
    # provider, so that guard fires and fails the build.
    #
    # Setting this false is therefore a build-stage necessity, not a weakening.
    # RESEND_API_KEY is a runtime service variable and passing a real one here
    # would bake a secret into a layer. The runtime stage is a separate FROM and
    # inherits nothing from here, so the container falls back to the real rule —
    # required whenever NODE_ENV is production — and still refuses to start
    # without a sender.
    CMS_REQUIRE_EMAIL_VERIFICATION=false \
    # `next build` imports every route module to collect page data, and
    # src/env.ts validates on import and throws when a required variable is
    # absent. Any route reaching env — the OAuth start route is the first —
    # therefore fails the build with "Failed to collect page data", which names
    # the route and not the cause.
    #
    # These are obviously-fake build-stage placeholders. The runtime stage is a
    # separate FROM and inherits none of them, so the container still reads the
    # real values and still refuses to start without them. Deliberately not
    # plausible: nothing here should ever be mistaken for a usable default.
    DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build-time-placeholder \
    BETTER_AUTH_SECRET=build-time-placeholder-not-a-real-secret-0000000000 \
    CMS_STUDIO_URL=http://build-time-placeholder.invalid

# transpilePackages compiles the workspace packages from source, so the build
# needs the whole tree above rather than a pruned copy.
RUN pnpm --filter @cms/studio build

# The workspace ships whole, dev dependencies included. Both ways of slimming it
# break this app. `pnpm deploy` into a pruned directory re-roots node_modules,
# and Next's build emits hashed references to its serverExternalPackages
# (postgres, pg, better-auth, sharp) that only resolve against the layout the
# build saw. Pruning in place is the same re-rooting by another name. Size is
# the price of an app that starts.

# --- runtime ------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    # Next binds this; the default is loopback in some versions, which the
    # reverse proxy cannot reach from another container.
    HOSTNAME=0.0.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd -r cms && useradd -r -g cms cms
WORKDIR /repo/apps/studio

# The workspace as the build left it: same paths, same symlinks, plus .next.
COPY --from=build --chown=cms:cms /repo /repo

USER cms
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/api/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
# The local binary rather than `pnpm start`: there is no pnpm in this stage.
CMD ["node_modules/.bin/next", "start", "--port", "3000"]
